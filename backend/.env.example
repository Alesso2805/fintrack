APP_NAME=FinTrack API
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5433/<db_name>
SECRET_KEY=<generate-a-random-secret-at-least-32-bytes>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
INITIAL_ADMIN_EMAIL=<admin-email>
INITIAL_ADMIN_PASSWORD=<strong-admin-password>
INITIAL_ADMIN_FULL_NAME=FinTrack Admin
